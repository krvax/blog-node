<!DOCTYPE html>
<html>
<head>
  <title>Mi Blog</title>
</head>
<body>
  <h1>Publicaciones recientes</h1>
  <a href="/new">Crear nueva publicación</a>
  <hr>
  <% posts.forEach(post => { %>
    <div>
      <h2><a href="/post/<%= post._id %>"><%= post.title %></a></h2>
      <p><%= post.content.substring(0, 100) %>...</p>
      <hr>
    </div>
  <% }) %>
</body>
</html>
